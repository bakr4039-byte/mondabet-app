      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.signed.response.alg": "RS256"
      }
    },
    {
      "clientId": "customer-portal",
      "name": "Customer Company Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://*.mondabet.sa/*",
        "http://localhost:4201/*"
      ],
      "webOrigins": [
        "https://*.mondabet.sa",
        "http://localhost:4201"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.signed.response.alg": "RS256"
      }
    }
  ],
  "components": {
