{
  "ConnectionStrings": {
    "IdentityDb": "Server=localhost,1433;Database=MondabetIdentity;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=true",
    "Redis": "localhost:6379,password=${REDIS_PASSWORD}"
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "mondabet",
    "ClientId": "identity-svc",
    "ClientSecret": "",
    "AdminClientId": "admin-cli",
    "AdminClientSecret": ""
  },
  "Jwt": {
    "Issuer": "https://auth.mondabet.sa/realms/mondabet",
    "Audience": "mondabet-api",
    "ExpiryMinutes": "15",
    "PublicKeyPem": "",
    "PrivateKeyPem": ""
  },
  "Otp": {
    "TtlMinutes": "5"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
