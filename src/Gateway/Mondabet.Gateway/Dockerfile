FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["src/Gateway/Mondabet.Gateway/Mondabet.Gateway.csproj", "src/Gateway/Mondabet.Gateway/"]
COPY ["src/Shared/Mondabet.Shared/Mondabet.Shared.csproj", "src/Shared/Mondabet.Shared/"]
COPY ["Directory.Build.props", "."]
COPY ["Directory.Packages.props", "."]
RUN dotnet restore "src/Gateway/Mondabet.Gateway/Mondabet.Gateway.csproj"
COPY . .
RUN dotnet publish "src/Gateway/Mondabet.Gateway/Mondabet.Gateway.csproj" \
    -c Release -o /app/publish --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Mondabet.Gateway.dll"]
